NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Trusted slot generation (lib/serverSlots.ts) invokes the
# write-capable ensure_daily_slots() RPC with this key.
# NEVER add a NEXT_PUBLIC_ prefix, NEVER commit a real value, NEVER use it
# in browser/Client Component code. Required for auto slot generation;
# without it the app falls back to reading existing rows.
SUPABASE_SERVICE_ROLE_KEY=

# Server-runtime canonical URL (Cloudflare Workers `vars`, see wrangler.jsonc).
# Read FIRST by lib/site.ts for metadataBase / canonical / sitemap because it
# resolves at request time; NEXT_PUBLIC_* values are inlined at build time.
SITE_URL=

# Build-time/local-dev fallback for the canonical URL.
# Set this ONLY to the real production domain, e.g. https://turf.example.com
# Leave empty in dev/preview so staging never becomes the canonical URL.
NEXT_PUBLIC_SITE_URL=

# Business timezone (do not change unless the facility moves)
# Used by lib/timezone.ts for all current-slot calculations.
NEXT_PUBLIC_BUSINESS_TIMEZONE=Asia/Kolkata
